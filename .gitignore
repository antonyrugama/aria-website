# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/

# Claude
.claude/

# Local
*.log

# Chrome profile written by scripts/check-ops-theme-redraw.mjs. Kept in the
# repository rather than a temp directory so the path is the same on a laptop
# and on the runner. The check deletes it after Chrome has exited; ignored for
# the run interrupted before it gets that far, and for the one where Chrome
# never exits, which the check reports when it gives up.
.ops-theme-redraw-*/

# Chrome profile written by scripts/check-ops-dialog-hit.mjs, on the same terms
# as the entry above: kept in the repository so the path matches on a laptop and
# on the runner, deleted once Chrome has exited, ignored for the interrupted run.
.ops-dialog-hit-*/

# Mutation-battery source snapshots (mutate-*.mjs restores from these)
.mutbak/

# Chrome profile written by scripts/ops-scroll-containment.test.mjs when
# RUNNER_TEMP is unset, which is every laptop; Actions always sets it, so on the
# runner this lands outside the repository. Same terms as the two entries above:
# removed once Chrome has exited, ignored for the run interrupted before that.
.ops-scroll-containment-*/
